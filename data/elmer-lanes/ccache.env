# Shared build cache for Elmer lanes. Source from the lane worktree root:
#   LANE_ROOT=<this lane's worktree> source data/elmer-lanes/ccache.env
# Measured recipe (ADR-045 §cache): distinct lane roots share one CCACHE_DIR;
# CCACHE_BASEDIR=$LANE_ROOT + sloppiness makes TU hashes path-independent
# given identical intra-lane layout (cmake -S $LANE_ROOT/src -B $LANE_ROOT/build).
# Verified 2026-10-14, ccache 4.9.1, 32-core host: 69/69 TU hits lane-B after
# lane-A populate; cross-root (different BASEDIR) 1 miss + 1 hit.

: "${LANE_ROOT:?set LANE_ROOT to the lane worktree root first}"
: "${ELMER_LANES_CACHE:=/home/john/firstmate/data/elmer-lanes-cache}"

export CCACHE_DIR="$ELMER_LANES_CACHE"
export CCACHE_BASEDIR="$LANE_ROOT"
export CCACHE_SLOPPINESS="file_macro include_file_mtime include_file_ctime time_macros pch_defines"
export CCACHE_MAXSIZE="20G"

# Pass to cmake configure:
#   -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
# Fortran (gfortran) also routes through ccache the same way; sccache is NOT
# used (ignores gfortran invocations, no cross-dir hits — measured, ADR-045).
