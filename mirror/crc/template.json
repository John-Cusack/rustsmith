{
  "package": "crc",
  "extension_module": "crc._crc",
  "src_layout": true,
  "files": [
    ["Cargo.toml", "Cargo.toml"],
    ["Cargo.lock", "Cargo.lock"],
    ["pyproject.toml", "pyproject.toml"],
    ["release.toml", "release.toml"],
    ["NOTICE", "NOTICE"],
    ["README.md", "README.md"],
    ["src/lib.rs", "src/lib.rs"],
    ["crc-core/Cargo.toml", "crc-core/Cargo.toml"],
    ["crc-core/src/lib.rs", "crc-core/src/lib.rs"],
    ["crc/__init__.py", "crc/__init__.py"]
  ],
  "extra_files": {
    "python:src/crc/__main__.py": [["crc/__main__.py", "crc/__main__.py"]]
  },
  "delete_on_merge": {
    "python:src/crc/_crc.py": ["src/crc/_crc.py"],
    "python:src/crc/__main__.py": ["src/crc/__init__.py", "src/crc/__main__.py"]
  },
  "orig_source": {
    "python:src/crc/_crc.py": "src/crc/_crc.py",
    "python:src/crc/__main__.py": "src/crc/__main__.py"
  }
}
